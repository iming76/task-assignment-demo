DATABASE_URL="postgresql://user:password@localhost:5434/task_assignment?schema=public"
PORT=3100

# Optional. Origin allowed by CORS. Defaults to http://localhost:3000.
# FRONTEND_URL="http://localhost:3000"

# Optional. Agent-assisted task planning (POST /agent-task) stays disabled
# (returns 503 AGENT_UNAVAILABLE) until an API key is set. The endpoint either
# asks one clarification question or atomically creates the full task tree
# after fresh server-side validation.
# AI_PROVIDER="openai"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_API_KEY=""
# AGENT_PLANNING_TIMEOUT_MS=30000

# Optional. Shares AI_PROVIDER/OPENAI_MODEL/OPENAI_API_KEY above. Automatic
# required-skill inference on task creation (POST /tasks with requiredSkillIds
# omitted) falls back to an untagged task until an API key is set; supplying
# requiredSkillIds (including []) always skips inference.
# SKILL_INFERENCE_TIMEOUT_MS=30000
