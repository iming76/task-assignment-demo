{
  "name": "task-assignment-demo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=frontend --filter=backend",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "packages/ui/**/*.{js,jsx,ts,tsx}": "eslint --fix --config packages/ui/eslint.config.mjs --max-warnings 0",
    "**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.7",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "js-yaml@4": "4.3.1",
      "nanoid@3": "3.3.18",
      "flatted@3": "3.4.2",
      "serialize-javascript@6": "7.0.3",
      "picomatch@2": "2.3.2"
    }
  }
}
