    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.5.8",
    "playwright": "^1.62.1",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
